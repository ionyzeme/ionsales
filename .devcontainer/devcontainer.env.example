# Copy this file to `.devcontainer/devcontainer.env` (gitignored) and fill in
# your sandbox environment URL. Then rebuild the devcontainer.
#
# The Dataverse environment ("org") URL — find it in the Power Platform admin
# center (admin.powerplatform.microsoft.com) under your environment's details,
# or in make.powerapps.com → Settings → Developer resources.
DATAVERSE_URL=https://YOURORG.crm.dynamics.com

# Optional: API root for the $metadata dump (Layer 3a). Usually the org URL with
# `.api.` inserted, e.g. https://YOURORG.api.crm.dynamics.com
DATAVERSE_API_URL=https://YOURORG.api.crm.dynamics.com
